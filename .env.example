# Copy to .env (the setup script does this) and paste your Massive API key. No spaces or quotes.
MASSIVE_API_KEY=your-key-here
# Required for optional live SEC metadata requests; use your real contact email.
SEC_USER_AGENT=GatorQuant your@email.example

# TypeSafe Jev (jack-uf's JEV experiments; jev.py --fill; hyp.py text features)
TYPESAFE_API_KEY=your-key-here

# Optional: only for the Filing Trial demo (trial/render_audio.py). The main notebook never reads it.
ELEVENLABS_API_KEY=your-key-here
